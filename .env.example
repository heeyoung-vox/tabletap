# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=tabletap.example.com
DB_PASSWORD=change-me-to-a-long-random-string
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# prod,demo also creates the two demo restaurants on first start.
SPRING_PROFILES_ACTIVE=prod,demo
