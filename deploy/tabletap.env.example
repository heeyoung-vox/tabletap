# Copy to /etc/tabletap/tabletap.env on the server and fill in. Never commit the real file.
# systemd reads it (EnvironmentFile in tabletap.service): one KEY=value per line, no quotes.
DB_URL=jdbc:postgresql://localhost:5432/tabletap
DB_USERNAME=tabletap
DB_PASSWORD=change-me-to-a-long-random-string
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# The public address written into QR codes. Your domain, with https://
APP_BASE_URL=https://tabletap.example.com
# prod,demo also creates the two demo restaurants on first start.
SPRING_PROFILES_ACTIVE=prod,demo
# Listen on localhost only. Caddy is the only public entry point.
SERVER_ADDRESS=127.0.0.1
